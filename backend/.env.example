# Copiar a .env y completar. Nunca commitear el .env.

# Supabase (Project Settings → API)
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon_key>
# Service role: saltea RLS. Solo en el servidor.
SUPABASE_SERVICE_KEY=<service_role_key>

# JWT propio que firma la API
JWT_SECRET=<secreto_largo_y_aleatorio>
JWT_EXPIRATION=7d

# OCR/IA de tickets (Groq, https://console.groq.com/keys)
GROQ_API_KEY=<api_key_groq>

# Servidor
PORT=3000
# Origen del frontend desplegado, para CORS (localhost:5500 ya está permitido)
FRONTEND_URL=http://localhost:5500

APP_TIMEZONE=America/Argentina/Buenos_Aires